# --- Production (Render / Railway / VPS) ---
NODE_ENV=production
PORT=3000

# Required in production — long random string; must match PC app SNIPER_WEBSITE_API_SECRET
SNIPER_WEBSITE_API_SECRET=change-me-to-a-long-random-string

# Optional: only if a browser on another origin must call the API (usually not needed)
# SNIPER_CORS_ORIGIN=https://www.sniperhunterz.com

# Optional: force ephemeral-disk warning in logs
# SNIPER_DISK_EPHEMERAL=1

# --- Local development ---
# NODE_ENV=development
# PORT=3000
# SNIPER_WEBSITE_API_SECRET=your-local-dev-secret

# Copy before first run:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
